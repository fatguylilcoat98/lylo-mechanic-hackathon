# Hackathon server config (hackathon/server). Copy to hackathon/.env (git-ignored).
# Baseline settings (baseline/render.yaml, baseline env vars) are NOT used or changed by this file.
# No real values here. Never commit hackathon/.env.

# Meta Model API
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL_TEXT=muse-spark-1.3
META_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# Hackathon server
LYLO_HACK_HOST=127.0.0.1
LYLO_HACK_PORT=5088
LYLO_HACK_DB_PATH=./hackathon/server/data/ledger.sqlite

# Baseline pipeline (imported read-only from baseline/backend)
# Baseline boot requires DATABASE_URL; a local sqlite file is enough.
BASELINE_DATABASE_URL=sqlite:///./hackathon/server/data/baseline.sqlite
# Disable Layer-12 external handshake call for demos (hackathon-side wrapper flag)
LYLO_HACK_DISABLE_EXTERNAL_HANDSHAKE=1

# Cost guard
META_MAX_CALLS_PER_DAY=200

# hackathon/server/.env (Dell only, chmod 600, gitignored) — Muse Detective
META_MODEL_API_KEY=
LYLO_HACK_MUSE=0
LYLO_HACK_MUSE_MODEL=muse-spark-1.3
# Photo + voice (hackathon/server, default off). Same Meta key as Muse.
LYLO_HACK_VISION=0
LYLO_HACK_VOICE=0
# LYLO_HACK_VISION_DEBUG_SAVE=1   # debug only: keeps stripped photos in /tmp/lylo-vision-debug
