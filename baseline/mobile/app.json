{
  "expo": {
    "name": "LYLO Mechanic",
    "slug": "lylo-mechanic",
    "version": "0.4.4",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.stangman1998.lylomechanic",
      "versionCode": 8,
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-fg.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.stangman1998.lylomechanic",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "LYLO Mechanic uses Bluetooth to talk to your OBDLink adapter.",
        "NSCameraUsageDescription": "LYLO Mechanic uses the camera for Photo Helper, to show where parts are on your car.",
        "NSMicrophoneUsageDescription": "LYLO Mechanic uses the microphone only after you tap \"Ask out loud\", to send your question about a scan."
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 23,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "LYLO Mechanic uses Bluetooth to talk to your OBDLink adapter.",
          "neverForLocation": true
        }
      ],
      "./plugins/withBluetoothClassic",
      "./plugins/withAndroidBaseColors",
      [
        "expo-av",
        {
          "microphonePermission": "LYLO Mechanic uses the microphone only after you tap \"Ask out loud\", to send your question about a scan."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "916eda9d-5bf2-40c4-abdb-22ea6e491d96"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
